{
  "name": "@actforce/file-manager",
  "version": "0.1.0",
  "description": "File manager React components — file browser, preview, upload, search, with shadcn/ui + Tailwind v4",
  "type": "module",
  "main": "./index.js",
  "module": "./index.js",
  "exports": {
    ".": "./index.js",
    "./components/*": "./components/*",
    "./hooks/*": "./hooks/*.js",
    "./lib/*": "./lib/*.js"
  },
  "files": [
    "index.js",
    "components",
    "hooks",
    "lib"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slider": "^1.4.7",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tooltip": "^1.2.16",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "docx-preview": "^0.3.7",
    "i18next": "^26.0.4",
    "lucide-react": "^1.7.0",
    "marked": "^17.0.4",
    "pptxviewjs": "^1.1.3",
    "prismjs": "^1.30.0",
    "react-i18next": "^17.0.2",
    "tailwind-merge": "^3.5.0",
    "xlsx": "^0.18.5",
    "zustand": "^5.0.14"
  }
}
