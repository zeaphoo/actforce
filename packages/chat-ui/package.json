{
  "name": "@actforce/chat-ui",
  "version": "0.1.0",
  "description": "Minimal chat UI primitives (drop-in replacement for a small subset of @assistant-ui/react).",
  "type": "module",
  "main": "./src/index.js",
  "module": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./markdown": "./src/markdown/index.js",
    "./markdown.css": "./src/markdown/markdown.css"
  },
  "files": [
    "src",
    "README.md"
  ],
  "sideEffects": false,
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.0",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.0"
  },
  "scripts": {
    "example": "vite --config example/vite.config.js",
    "build:example": "vite build --config example/vite.config.js"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^5.4.0"
  }
}
